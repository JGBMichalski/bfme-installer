<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.jgbmichalski.BfmeInstaller</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>BFME Installer</name>
  <summary>Run the BFME All-in-One Launcher and Online Arena on Linux</summary>
  <description>
    <p>Sets up Proton automatically and runs the BFME All-in-One Launcher and the Online Arena, so you can install, mod and play Battle for Middle-earth 1, 2 and Rise of the Witch-king, including online play with Windows players.</p>
  </description>
  <launchable type="desktop-id">com.jgbmichalski.BfmeInstaller.desktop</launchable>
  <launchable type="desktop-id">com.jgbmichalski.BfmeInstaller.Launcher.desktop</launchable>
  <launchable type="desktop-id">com.jgbmichalski.BfmeInstaller.Arena.desktop</launchable>
  <url type="homepage">https://github.com/JGBMichalski/bfme-installer</url>
  <url type="vcs-browser">https://github.com/JGBMichalski/bfme-installer</url>
  <content_rating type="oars-1.1"/>
  <!-- CI fills in the version (from the git tag) and the date. -->
  <releases>
    <release version="@BFME_VERSION@" date="@BFME_DATE@"/>
  </releases>
</component>
